# Copy to .env and fill in the values. Never commit .env (it is git-ignored).
# Where to get each value is explained in README.md, "Credentials".

# Gemini API key (Google AI Studio): script generation and narration
GEMINI_API_KEY=your-gemini-api-key
# Cloudflare account id and a Workers AI API token: keyframes
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# Kaggle: your username, plus ONE of the two credentials below (or run `kaggle auth login`)
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_API_TOKEN=your-kaggle-api-token
# KAGGLE_KEY=your-legacy-kaggle-key

# Optional: Kaggle polling interval and the longest wait for one kernel run, in seconds
# HERITAGE_POLL_S=30
# HERITAGE_REMOTE_TIMEOUT_S=10800
