{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storyboard",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "target_seconds", "language", "voice", "style", "character", "music", "shots"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "target_seconds": {"type": "number", "minimum": 4,
      "description": "intended film length in seconds, including the 3 s end card; the script stage drafts shots from it"},
    "text_model": {"enum": ["gemini-3.5-flash-lite", "gemini-3.8-flash"],
      "description": "Gemini text model for the script stage; gemini-3.5-flash-lite (default)"},
    "keyframe_model": {"enum": ["flux-2-klein-4b", "flux-1-schnell"],
      "description": "keyframe image model; flux-2-klein-4b (default) can take character.reference_image"},
    "assessment_rules": {"type": "boolean",
      "description": "true: enforce the 10 Academy rules (8-12 shots, 60-90 s including the end card)"},
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["premise", "audience", "intent"],
      "properties": {
        "premise": {"type": "string", "minLength": 1, "maxLength": 1000},
        "audience": {"type": "string", "minLength": 1, "maxLength": 1000},
        "intent": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "language": {"type": "string", "minLength": 1, "maxLength": 40},
    "voice": {"enum": ["Zephyr", "Puck", "Charon", "Kore", "Fenrir", "Leda", "Orus", "Aoede", "Callirrhoe", "Autonoe",
      "Enceladus", "Iapetus", "Umbriel", "Algieba", "Despina", "Erinome", "Algenib", "Rasalgethi", "Laomedeia",
      "Achernar", "Alnilam", "Schedar", "Gacrux", "Pulcherrima", "Achird", "Zubenelgenubi", "Vindemiatrix",
      "Sadachbia", "Sadaltager", "Sulafat"]},
    "seed": {"type": "integer", "minimum": 0},
    "style": {"type": "string", "minLength": 1, "maxLength": 500},
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "description": {"type": "string", "minLength": 1, "maxLength": 1000},
        "reference_image": {"type": "string", "minLength": 1, "maxLength": 300,
          "description": "path, relative to the repository root, of an approved image of the character; flux-2-klein-4b conditions every shot keyframe on it"}
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt"],
      "properties": {
        "prompt": {"type": "string", "minLength": 1, "maxLength": 500},
        "choice": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate", "reason"],
          "properties": {
            "candidate": {"type": "integer", "minimum": 1, "maximum": 3},
            "reason": {"type": "string", "minLength": 1, "maxLength": 500}
          }
        }
      }
    },
    "end_card": {"type": "string", "minLength": 1, "maxLength": 60},
    "setting": {"type": "string", "minLength": 1, "maxLength": 1000,
      "description": "where the film takes place; used in the keyframe prompts of shots marked character_reference: false, which carry no character description"},
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "duration", "reason", "keyframe_prompt", "motion_prompt", "narration", "subtitle", "music_cue"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_-]{1,32}$"},
          "duration": {"type": "number", "exclusiveMinimum": 0, "maximum": 8},
          "reason": {"type": "string", "minLength": 1, "maxLength": 300},
          "keyframe_prompt": {"type": "string", "minLength": 1, "maxLength": 1000},
          "motion_prompt": {"type": "string", "minLength": 1, "maxLength": 500},
          "narration": {"type": "string", "minLength": 1, "maxLength": 400},
          "subtitle": {"type": "string", "minLength": 1, "maxLength": 200},
          "music_cue": {"type": "string", "minLength": 1, "maxLength": 80},
          "character_reference": {"type": "boolean",
            "description": "false: this shot shows no character, so its keyframe gets no character.reference_image (default true)"}
        }
      }
    }
  }
}
